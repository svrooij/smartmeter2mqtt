{
  "name": "smartmeter2mqtt",
  "version": "0.0.0-development",
  "description": "Publish data from your Smartmeter with a P1 interface to your MQTT server.",
  "main": "dist/index.js",
  "scripts": {
    "compile": "tsc",
    "copy-www": "cp -r ./src/output/wwwroot ./dist/output/wwwroot",
    "copy-www-win": "xcopy .\\src\\output\\wwwroot .\\dist\\output\\wwwroot /E/H/C/I/d/Y",
    "coverage": "jest --coverage",
    "jest": "jest",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint-fix": "eslint ./src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "npm run lint && jest",
    "prepack": "npm run compile && npm run copy-www",
    "prepack-win": "npm run compile && npm run copy-www-win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/svrooij/smartmeter2mqtt.git"
  },
  "keywords": [
    "mqtt-smarthome",
    "P1",
    "smart",
    "meter",
    "electricity"
  ],
  "author": "Stephan van Rooij <github@svrooij.io> (https://svrooij.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/svrooij/smartmeter2mqtt/issues"
  },
  "homepage": "https://github.com/svrooij/smartmeter2mqtt#readme",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "@serialport/parser-readline": "^13.0.0",
    "@svrooij/sunspec": "^0.9.0",
    "@svrooij/tcp-server": "^1.0.1",
    "crc": "^3.8.0",
    "express": "^4.21.2",
    "mqtt": "^5.10.4",
    "node-fetch": "^3.3.2",
    "serialport": "^13.0.0",
    "typed-emitter": "^2.1.0",
    "ws": "^8.18.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.0",
    "@types/crc": "^3.4.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/node-fetch": "^2.6.12",
    "@types/ws": "^8.18.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^4.29.3",
    "chai": "^5.2.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^14.0.0",
    "eslint-plugin-import": "^2.24.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.5.0"
  },
  "bin": {
    "smartmeter2mqtt": "./bin/run"
  },
  "files": [
    "bin/run",
    "bin/run.cmd",
    "dist/**/*.js",
    "dist/output/wwwroot"
  ]
}
